# ==============================================================================
# Voice AI Platform - Frontend Environment Configuration Example
# Copy this file to .env.local and replace placeholders with your actual credentials.
# NEVER commit .env.local or real secret keys to Git!
# ==============================================================================

# Supabase Public Configuration (Browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Backend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:3001
