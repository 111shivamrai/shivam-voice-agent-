# ==============================================================================
# Voice AI Platform - Backend Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit .env or real secret keys to Git!
# ==============================================================================

# Server Network Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000

# Public URL reachable by Telnyx webhooks, media streaming, and audio playback.
# For local development: Use ngrok (e.g. https://your-tunnel.ngrok-free.app)
# For production: Use your deployed domain (e.g. https://api.yourdomain.com or Railway URL)
BACKEND_URL=http://localhost:3001

# Supabase Credentials (Database, Auth, Storage, and Vector RPC)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key

# OpenAI API Key (Embeddings & Agent RAG Reasoning)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Sarvam AI Credentials (Saaras v3 STT & Bulbul v3 TTS)
SARVAM_API_KEY=sk_your_sarvam_api_key_here

# Telnyx Telephony Credentials & Configuration
# 1. TELNYX_API_KEY: v2 API key from Telnyx Portal (Account Settings -> Keys & Credentials)
TELNYX_API_KEY=KEY0123456789ABCDEF_your_telnyx_api_key_here

# 2. TELNYX_CONNECTION_ID / TELNYX_APP_ID: Call Control Application ID (UUID from Voice -> Call Control Applications)
TELNYX_CONNECTION_ID=00000000-0000-0000-0000-000000000000
TELNYX_APP_ID=00000000-0000-0000-0000-000000000000

# 3. TELNYX_PHONE_NUMBER: Default outbound caller ID in E.164 format (e.g. +18005550199)
TELNYX_PHONE_NUMBER=+18005550199

# Administrative Access Password
ADMIN_PASSWORD=your_secure_admin_password_here
